[telegram]
bot_token = YOUR_TELEGRAM_BOT_TOKEN
chat_id = YOUR_TELEGRAM_CHAT_ID
allowed_user_id = YOUR_TELEGRAM_USER_ID
; Optional. Use this if api.telegram.org is unavailable directly.
; Examples:
; proxy = http://127.0.0.1:8080
; proxy = socks5://127.0.0.1:1080

[steam]
api_key = YOUR_STEAM_WEB_API_KEY
poll_interval_seconds = 10
status_reminder_interval_seconds = 3600
persona_state_debounce_seconds = 120
notify_on_start = true
monitor_comments = true
monitor_friends = true
monitor_badges = true
monitor_rich_presence = true
monitor_cs2 = true

[steamid_uk]
enabled = false
api_key = YOUR_STEAMID_UK_API_KEY
myid = YOUR_STEAMID64
; SteamID.uk steamid.php limit is lower than the converter limit, so keep this slow.
refresh_interval_seconds = 21600
sync_watchlist = false
watchlist_id = 1

[accounts]
76561198000000001 = Main
76561198000000002 = Alt

; Можно также задавать аккаунты отдельными секциями:
; [account:my_second_format]
; steam_id = 76561198000000003
; label = Another account
